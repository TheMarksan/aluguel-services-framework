# ==========================================================================
# Configuracao do API Gateway (porta 8003)
# Copie para .env e ajuste conforme o ambiente.
# ==========================================================================

# Porta em que o Gateway escuta
GATEWAY_PORT=8003

# URLs internas dos microsservicos (comunicacao via cURL)
MS_AUTH_URL=http://localhost:8000
MS_CATALOGO_URL=http://localhost:8001
MS_RESERVAS_URL=http://localhost:8002

# Timeout (segundos) para chamadas internas via cURL
HTTP_TIMEOUT=10
