{
    "name": "ufal/aluguel-gateway",
    "description": "API Gateway do Framework Whitelabel de Aluguel - roteamento stateless via cURL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Gateway\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
