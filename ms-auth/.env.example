# ==========================================================================
# Configuracao do ms-auth (porta 8000)
# ==========================================================================

# Banco de dados (db_auth)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_auth
DB_USER=root
DB_PASS=

# JWT (HS256)
# IMPORTANTE: troque por um segredo forte e mantenha fora do versionamento.
JWT_SECRET=troque-este-segredo-super-secreto
JWT_ISSUER=ms-auth
JWT_TTL=3600
